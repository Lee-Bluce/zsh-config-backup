# ==============================================================================
#  ~/.zshrc  ——  由 omz-setup 一键安装脚本部署（可移植版）
# ------------------------------------------------------------------------------
#  · 本文件会被 install.sh 更新覆盖，请不要直接在这里写私有配置。
#  · 你的私有配置请写到 ~/.zshrc.local，它会在文件末尾自动加载。
#  · 主题模式由 ~/.config/omz-setup/mode 决定：p10k | simple
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. 定位 oh-my-zsh
# ------------------------------------------------------------------------------
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
_omz_custom_dir="${ZSH_CUSTOM:-$ZSH/custom}"

# ------------------------------------------------------------------------------
# 1. 语言环境（服务器 locale 经常缺失，做回退以免 zsh 反复告警）
# ------------------------------------------------------------------------------
if [[ -z "${LANG:-}" || "${LANG:-}" == "C" || "${LANG:-}" == "POSIX" ]]; then
  if locale -a 2>/dev/null | grep -qiE '^en_US\.utf-?8$'; then
    export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
  elif locale -a 2>/dev/null | grep -qiE '^C\.utf-?8$'; then
    export LANG=C.UTF-8 LC_ALL=C.UTF-8
  fi
fi

# ------------------------------------------------------------------------------
# 2. 选择主题
#    · simple（服务器默认）：oh-my-zsh 内置简洁主题，无需 Nerd Font，不会出方块
#    · p10k  （Mac 默认）  ：与本地 Mac 完全一致的观感
# ------------------------------------------------------------------------------
_omz_mode=""
[[ -r "$HOME/.config/omz-setup/mode" ]] && _omz_mode="$(<"$HOME/.config/omz-setup/mode")"

_omz_p10k_ready=0
if [[ -f "$_omz_custom_dir/themes/powerlevel10k/powerlevel10k.zsh-theme" && -f "$HOME/.p10k.zsh" ]]; then
  _omz_p10k_ready=1
fi

if [[ "$_omz_mode" == "p10k" || ( -z "$_omz_mode" && $_omz_p10k_ready -eq 1 ) ]]; then
  # 2.1 Instant Prompt 必须放在最顶部，否则无效（仅 p10k 需要）
  if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
  fi
  # 彻底静音 Instant Prompt 的警告（防止任何后台输出干扰）
  typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet

  ZSH_THEME="powerlevel10k/powerlevel10k"
  _omz_use_p10k=1
else
  ZSH_THEME="${ZSH_THEME:-robbyrussell}"
  _omz_use_p10k=0
fi

# ------------------------------------------------------------------------------
# 3. 插件列表（由 install.sh 克隆到 $ZSH_CUSTOM/plugins）
#    注意：zsh-syntax-highlighting 必须放在最后
# ------------------------------------------------------------------------------
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
)

# ------------------------------------------------------------------------------
# 4. 加载 Oh My Zsh（必须在主题和插件设置之后）
# ------------------------------------------------------------------------------
source "$ZSH/oh-my-zsh.sh"

# ------------------------------------------------------------------------------
# 5. 提示符
#    · p10k 模式      ：加载你的 .p10k.zsh，与 Mac 完全一致（含图标）
#    · simple 模式    ：纯 zsh 复刻 Mac 上 p10k classic 的布局，无需 Nerd Font
#
#      ╭─ ~/Documents/Ai/tmpwork  git:(main)          ✔ at 13:55:42
#      ╰─❯
# ------------------------------------------------------------------------------
if [[ "${_omz_use_p10k:-0}" -eq 1 && -f "$HOME/.p10k.zsh" ]]; then
  source "$HOME/.p10k.zsh"
else
  # 只读 .git/HEAD 文件，不 fork git 进程，避免拖慢提示符
  _omz_git_head() {
    local d="$PWD" g h=""
    while :; do
      if [[ -d "$d/.git" && -f "$d/.git/HEAD" ]]; then
        h="$d/.git/HEAD"
      elif [[ -f "$d/.git" ]]; then
        g="$(<"$d/.git" 2>/dev/null)"; g="${g#gitdir: }"
        [[ -n "$g" && -f "$g/HEAD" ]] && h="$g/HEAD"
      fi
      if [[ -n "$h" ]]; then
        print -r -- "$(<"$h" 2>/dev/null)"
        return
      fi
      [[ "$d" == "/" || "$d" == "." ]] && return
      d="${d:h}"
    done
  }

  _omz_prompt_precmd() {
    local ret=$?                      # 必须第一行取值
    emulate -L zsh

    # --- 路径（完整路径，~ 缩写，与 Mac 一致）---
    local path_text="${(%):-%~}"
    local path_w=${(m)#path_text}

    # --- git 分支 ---
    local branch head branch_prompt="" branch_plain="" branch_w=0
    head="$(_omz_git_head)"
    if [[ -n "$head" ]]; then
      branch="${head#ref: refs/heads/}"
      [[ "$branch" == "$head" ]] && branch="${head[1,7]}"   # detached HEAD
      branch="${branch//\%/%%}"
      branch_plain=" git:($branch)"
      branch_prompt=" %F{76}git:(%f%F{76}${branch}%F{76})%f"
      branch_w=${(m)#branch_plain}
    fi

    # --- 状态标记：成功绿 ✔ / 失败红 ✘ ---
    local status_plain status_prompt
    if (( ret == 0 )); then
      status_plain='✔ '
      status_prompt='%F{70}✔%f '
    else
      status_plain='✘ '
      status_prompt='%F{160}✘%f '
    fi

    # --- 右侧：状态 + "at HH:MM:SS"（固定 13 列）---
    local right_w=$(( ${(m)#status_plain} + 11 ))
    local cols=${COLUMNS:-80}
    local frame_w=3                   # "╭─ "
    local pad=$(( cols - 1 - frame_w - path_w - branch_w - right_w ))

    if (( pad < 0 )); then            # 终端太窄：先舍弃 git 分支
      branch_prompt=""; branch_w=0
      pad=$(( cols - 1 - frame_w - path_w - right_w ))
    fi
    if (( pad < 0 )); then            # 仍然太窄：只留路径，不显示右侧信息
      PROMPT="%F{242}╭─%f %F{31}%~%f"$'\n'"%F{242}╰─%f %F{76}❯%f "
      return
    fi
    (( pad < 1 )) && pad=1

    PROMPT="%F{242}╭─%f %F{31}%~%f${branch_prompt}${(l:pad:: :)}${status_prompt}%F{66}at %D{%H:%M:%S}%f"$'\n'"%F{242}╰─%f %F{76}❯%f "
  }

  autoload -Uz add-zsh-hook 2>/dev/null
  if (( ${+functions[add-zsh-hook]} )); then
    add-zsh-hook precmd _omz_prompt_precmd
  else
    precmd_functions+=(_omz_prompt_precmd)
  fi
  RPROMPT=""
  PROMPT2="%F{242}%_%f %F{76}❯%f "
  # 窗口大小变化时重绘，保证右侧时间仍然贴边
  TRAPWINCH() { [[ -o zle ]] && zle reset-prompt }
fi

# ------------------------------------------------------------------------------
# 6. 杂项补丁
# ------------------------------------------------------------------------------

# zsh-syntax-highlighting 默认会给「合法路径 / cd 的目录参数」加下划线，
# 观感上像一条横线。这里去掉下划线（保留 cd 本身的绿色）。
# 想改成颜色提示而不是去掉，可把 'none' 换成 'fg=cyan' 之类。
if (( ${+ZSH_HIGHLIGHT_STYLES} )); then
  ZSH_HIGHLIGHT_STYLES[path]='none'
  ZSH_HIGHLIGHT_STYLES[path_prefix]='none'
  ZSH_HIGHLIGHT_STYLES[autodirectory]='fg=green'
  ZSH_HIGHLIGHT_STYLES[precommand]='fg=green'
fi

# 清理可能存在的旧 alias 冲突（历史遗留问题）
unalias -m 'h' 2>/dev/null

# Homebrew：只在 macOS 有意义，在 Linux 上设置也无害
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_NO_AUTO_UPDATE=1

# ------------------------------------------------------------------------------
# 7. 通用 PATH（存在才加，避免污染）
# ------------------------------------------------------------------------------
for _omz_dir in "$HOME/.local/bin" "$HOME/bin" "$HOME/.opencode/bin"; do
  if [[ -d "$_omz_dir" && ":$PATH:" != *":$_omz_dir:"* ]]; then
    export PATH="$_omz_dir:$PATH"
  fi
done
unset _omz_dir

# ------------------------------------------------------------------------------
# 8. 本机私有配置（不会被安装脚本覆盖）
# ------------------------------------------------------------------------------
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# shellcheck disable=SC2034
: "${_omz_use_p10k:=0}"
